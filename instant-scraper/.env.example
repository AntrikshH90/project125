# Instant Scraper — environment
# Everything works keyless. Keys are optional upgrades.

# GitHub: 60 req/hr keyless → 5000 req/hr with token
GITHUB_TOKEN=

# Hugging Face: gated datasets + higher row-API limits
HF_TOKEN=

# Any OpenAI-compatible key enables LLM intent parsing (fuzzy/Hinglish asks).
# Works with OpenAI directly, tokenrouter, openrouter, ollama/vllm proxies, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
